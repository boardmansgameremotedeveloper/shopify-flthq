{%- assign flt_af_count = count | default: 18 -%}

<style>
.flt-af-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

@keyframes flt-af-drift {
  0%   { transform: translateX(calc(100vw + 60px)); opacity: 0; }
  8%   { opacity: 0.7; }
  85%  { opacity: 0.5; }
  96%  { opacity: 0; }
  100% { transform: translateX(-60px); opacity: 0; }
}

.flt-af-flower {
  position: absolute;
  animation: flt-af-drift linear infinite;
  filter: drop-shadow(0 0 8px rgba(255,255,255,0.9))
          drop-shadow(0 0 20px rgba(135,206,235,0.7));
}

@media (max-width: 768px) {
  .flt-af-flower { width: 32px; height: 32px; }
}
</style>

<div class="flt-af-stage" aria-hidden="true">
  {%- for i in (1..flt_af_count) -%}
    {%- assign top_pct = i | times: 7 | modulo: 80 | plus: 5 -%}
    {%- assign dur     = i | times: 7 | modulo: 12 | plus: 10 -%}
    {%- assign del     = i | times: 11 | modulo: dur -%}
    <div class="flt-af-flower"
         style="top:{{ top_pct }}%; animation-duration:{{ dur }}s; animation-delay:-{{ del }}s;">
      <svg width="48" height="48" viewBox="0 0 500 500">
        <g transform="translate(250,250)" stroke="white" stroke-width="3" fill="none">
          <circle r="50"/>
          <circle cx="50"  cy="0"     r="50"/>
          <circle cx="-50" cy="0"     r="50"/>
          <circle cx="25"  cy="43.3"  r="50"/>
          <circle cx="-25" cy="43.3"  r="50"/>
          <circle cx="25"  cy="-43.3" r="50"/>
          <circle cx="-25" cy="-43.3" r="50"/>
        </g>
      </svg>
    </div>
  {%- endfor -%}
</div>
