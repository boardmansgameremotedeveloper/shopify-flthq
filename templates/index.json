    "flt_story_2_HBnmqX": {
      "type": "flt-story-2",
      "name": "FLT Story 2",
      "settings": {
        "eyebrow": "Our Story",
        "heading": "Built for Those Who Soar",
        "intro": "FLT was born long before the first can was cracked. It began in the sky — and in the values of those who flew.",
        "beat_1_title": "FLT's Roots",
        "beat_1_body": "FLT was born long before the first can was cracked or the first gummy was nibbled on. It all began in the sky — with three generations of military aviators who served in World War II, the Korean War, and Vietnam, earning Purple Hearts, a Distinguished Flying Cross, and a Silver Star. Their values: respect the craft, respect the body, and never cut corners.",
        "beat_2_title": "A New Kind of Flight",
        "beat_2_body": "Our products feature nanosized THC technology for faster onset, greater consistency, and lower required doses than traditional edibles. Our beverages are zero sugar, zero calories, electrolyte infused — clean, minimal ingredients engineered for rapid hydration and effect.",
        "beat_3_title": "Gummies, Refined",
        "beat_3_body": "All-natural fruit gummies with no added sugar. Vegan friendly. Rapid-release absorption. Clean, transparent ingredients you can read and trust. No fillers, no shortcuts.",
        "beat_4_title": "Giving Back",
        "beat_4_body": "A portion of all proceeds are donated to non-profit organizations that assist veterans. This isn't a marketing initiative — it's a family commitment carried forward from the people who built FLT.",
        "mission": "FLT exists at the intersection of heritage and innovation — where the discipline of aviation meets modern cannabinoid science.",
